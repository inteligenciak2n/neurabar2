# ── Stage 1: PHP dependencies ────────────────────────────────────────────────
FROM composer:2 AS composer-deps

WORKDIR /app

COPY composer.json composer.lock ./

# --no-scripts: artisan ainda não está disponível nesta fase
# --ignore-platform-reqs: a imagem composer pode não ter todas as extensões PHP
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-scripts \
    --ignore-platform-reqs

# ── Stage 2: Assets pré-compilados ────────────────────────────────────────────
# Para buildar o frontend separadamente:
#   docker build -f Dockerfile.frontend -t neurabar/assets:latest \
#     --build-arg VITE_PUSHER_APP_KEY=... . \
#     && docker compose -f compose.prod.yaml up -d --build app
#
# Para fazer apenas deploy de backend (frontend já compilado):
#   docker compose -f compose.prod.yaml up -d --build app
ARG ASSETS_IMAGE=neurabar/assets:latest
FROM ${ASSETS_IMAGE} AS assets

# ── Stage 3: PHP Application ──────────────────────────────────────────────────
FROM php:8.2-apache

# System dependencies
RUN apt-get update && apt-get install -y \
        git \
        curl \
        libpng-dev \
        libpq-dev \
        libzip-dev \
        libonig-dev \
        libicu-dev \
        zip \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions
RUN docker-php-ext-configure intl \
    && docker-php-ext-configure gd \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo \
        pdo_pgsql \
        zip

# Redis extension via PECL
RUN pecl install redis && docker-php-ext-enable redis

# Enable Apache modules
RUN a2enmod rewrite headers

# Set document root to public/
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Opcache tuning for production
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.interned_strings_buffer=16'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
} > /usr/local/etc/php/conf.d/opcache.ini

# Install Composer (usado apenas para rodar scripts artisan se necessário em runtime)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy application source
COPY . .

# Reusar o vendor já instalado no Stage 1 (evita rodar composer install novamente)
COPY --from=composer-deps /app/vendor ./vendor

# Copy compiled assets from Stage 2
COPY --from=assets /app/public/build ./public/build

# Criar estrutura de diretórios que o artisan precisa (storage é volume em runtime,
# mas precisa existir na imagem para os comandos abaixo não falharem)
RUN mkdir -p storage/framework/{sessions,views,cache/data} \
    storage/logs \
    bootstrap/cache

# Rodar apenas package:discover no build — optimize e view:cache devem ser
# executados manualmente após `docker compose up` (junto com key:generate e migrate).
RUN echo "APP_ENV=production\nAPP_KEY=build-placeholder" > .env \
    && php artisan package:discover --ansi \
    && rm .env

# Permissions — storage e bootstrap/cache são montados como volumes em runtime
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 80
