# ── Stage 1: PHP dependencies (necessário antes do Vite por causa do Ziggy) ──
FROM composer:2 AS composer-deps

WORKDIR /app

COPY composer.json composer.lock ./

# --no-scripts: artisan ainda não está disponível nesta fase
# --ignore-platform-reqs: a imagem composer pode não ter todas as extensões PHP
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-scripts \
    --ignore-platform-reqs

# ── Stage 2: Build frontend assets ───────────────────────────────────────────
FROM node:20-alpine AS assets

# VITE_ vars são incorporadas no JS compilado (não são segredos).
# Passe via --build-arg ou defina em compose.prod.yaml > build.args
ARG APP_URL=https://app.neurabar.com
ARG VITE_APP_NAME=NeuraBar
ARG VITE_PUSHER_APP_KEY=""
ARG VITE_PUSHER_HOST=""
ARG VITE_PUSHER_PORT=443
ARG VITE_PUSHER_SCHEME=https

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# O resources/js/app.js importa Ziggy de ../../vendor/tightenco/ziggy.
# Copiamos apenas o pacote necessário do stage anterior para não inflar a imagem.
COPY --from=composer-deps /app/vendor/tightenco ./vendor/tightenco

# laravel-vite-plugin lê o .env em tempo de build para APP_URL e VITE_*
RUN echo "APP_URL=${APP_URL}" > .env \
    && echo "VITE_APP_NAME=${VITE_APP_NAME}" >> .env \
    && echo "VITE_PUSHER_APP_KEY=${VITE_PUSHER_APP_KEY}" >> .env \
    && echo "VITE_PUSHER_HOST=${VITE_PUSHER_HOST}" >> .env \
    && echo "VITE_PUSHER_PORT=${VITE_PUSHER_PORT}" >> .env \
    && echo "VITE_PUSHER_SCHEME=${VITE_PUSHER_SCHEME}" >> .env

# Aumenta heap do Node para evitar OOM em builds com Vite + Vue + Tailwind
ENV NODE_OPTIONS="--max-old-space-size=2048"

RUN npm run build

# ── Stage 3: PHP Application ──────────────────────────────────────────────────
FROM php:8.2-apache

# System dependencies
RUN apt-get update && apt-get install -y \
        git \
        curl \
        libpng-dev \
        libpq-dev \
        libzip-dev \
        libonig-dev \
        libicu-dev \
        zip \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions
RUN docker-php-ext-configure intl \
    && docker-php-ext-configure gd \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo \
        pdo_pgsql \
        zip

# Redis extension via PECL
RUN pecl install redis && docker-php-ext-enable redis

# Enable Apache modules
RUN a2enmod rewrite headers

# Set document root to public/
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Opcache tuning for production
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.interned_strings_buffer=16'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
} > /usr/local/etc/php/conf.d/opcache.ini

# Install Composer (usado apenas para rodar scripts artisan se necessário em runtime)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy application source
COPY . .

# Reusar o vendor já instalado no Stage 1 (evita rodar composer install novamente)
COPY --from=composer-deps /app/vendor ./vendor

# Copy compiled assets from Stage 2
COPY --from=assets /app/public/build ./public/build

# Rodar package:discover agora que o artisan e o vendor estão disponíveis
RUN echo "APP_ENV=production\nAPP_KEY=build-placeholder" > .env \
    && php artisan package:discover --ansi \
    && php artisan optimize \
    && rm .env

# Permissions — storage e bootstrap/cache são montados como volumes em runtime
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 80
